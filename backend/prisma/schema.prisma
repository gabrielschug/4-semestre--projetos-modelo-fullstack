generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       String    @id @default(uuid())
  nome     String
  email    String    @unique
  senha    String
  produtos Produto[]

  @@map("admins")
}

model ValorEntrega {
  id                  Int    @id @default(autoincrement())
  bairro              String @unique
  valor               Float
  tempoEntregaMinutos Int    @default(30)

  enderecos Endereco[]

  @@map("valores_entregas")
}

model Cliente {
  id       String  @id @default(uuid())
  nome     String
  telefone String  @unique
  senha    String?

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("clientes")
}

model Endereco {
  id     Int     @id @default(autoincrement())
  titulo String
  rua    String
  numero String
  obs    String?

  bairroID  Int
  bairro    ValorEntrega @relation(fields: [bairroID], references: [id])
  clienteID String
  cliente   Cliente      @relation(fields: [clienteID], references: [id])

  @@map("enderecos_clientes")
}

model Pedido {
  id                        Int             @id @default(autoincrement())
  modalEntrega              ModalEntrega
  pagamento                 MetodoPagamento
  valorTotal                Float
  status                    StatusPedido    @default(PENDENTE)
  dataHora                  DateTime        @default(now())
  tempoTotalEstimadoMinutos Int
  anotacaoCliente           String?
  anotacaoAdm               String?

  ruaEntrega              String?
  numeroEntrega           String?
  obsEntrega              String?
  nomeBairroEntrega       String?
  valorTaxaEntrega        Float?

  clienteID String
  cliente   Cliente       @relation(fields: [clienteID], references: [id])
  itens     ItensPedido[]

  @@map("pedidos")
}

model ItensPedido {
  id           Int   @id @default(autoincrement())
  quantidade   Int
  precoProduto Float
  avaliacao    Int?  @db.SmallInt

  pedidoID  Int
  pedido    Pedido  @relation(fields: [pedidoID], references: [id])
  produtoID Int
  produto   Produto @relation(fields: [produtoID], references: [id])

  @@map("itens_pedidos")
}

model Produto {
  id                  Int           @id @default(autoincrement())
  descricao           String
  categoria           String
  precoBase           Float
  valorDesconto       Float?        @default(0)
  disponibilidade     Boolean       @default(true)
  especificacoes      String?
  fraseVenda          String?
  fotoUrl             String?
  tempoPreparoMinutos Int?
  adminID             String
  itensPedidos        ItensPedido[]
  admin               Admin         @relation(fields: [adminID], references: [id])

  @@map("produtos")
}

model Configuracao {
  id                    String @id @default(uuid())
  tempoAdicionalMinutos Int    @default(0)

  @@map("configuracoes")
}

enum StatusPedido {
  PENDENTE
  PREPARANDO
  PRONTO
  EM_ROTA
  ENTREGUE
  CANCELADO
}

enum ModalEntrega {
  DELIVERY
  RETIRADA
}

enum MetodoPagamento {
  DINHEIRO
  MAQUININHA_CARTAO
}
