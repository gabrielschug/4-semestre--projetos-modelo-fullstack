generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       String    @id @default(uuid())
  nome     String
  email    String    @unique
  senha    String
  produtos Produto[]

  @@map("admins")
}

model ValorEntrega {
  id                  String    @id @default(uuid())
  bairro              String    @unique
  valor               Float
  tempoEntregaMinutos Int       @default(30)
  clientes            Cliente[]

  @@map("valores_entregas")
}

model Cliente {
  id       String       @id @default(uuid())
  nome     String
  telefone String       @unique
  senha    String
  rua      String
  numero   String
  obs      String?
  bairroID String
  bairro   ValorEntrega @relation(fields: [bairroID], references: [id])
  pedidos  Pedido[]

  @@map("clientes")
}

model Produto {
  id                  String        @id @default(uuid())
  descricao           String
  categoria           String
  precoBase           Float
  valorDesconto       Float?        @default(0)
  disponibilidade     Boolean       @default(true)
  especificacoes      String?
  fotoUrl             String?
  tempoPreparoMinutos Int?
  adminID             String
  itensPedidos        ItensPedido[]
  admin               Admin         @relation(fields: [adminID], references: [id])

  @@map("produtos")
}

model Pedido {
  id                        String          @id @default(uuid())
  status                    StatusPedido    @default(PENDENTE)
  dataHora                  DateTime        @default(now())
  modalEntrega              ModalEntrega
  pagamento                 MetodoPagamento
  valorTotal                Float
  tempoTotalEstimadoMinutos Int
  anotacaoCliente           String?
  anotacaoAdm               String?
  clienteID                 String
  itens                     ItensPedido[]
  cliente                   Cliente         @relation(fields: [clienteID], references: [id])

  @@map("pedidos")
}

model ItensPedido {
  id           String  @id @default(uuid())
  quantidade   Int
  precoProduto Float
  pedidoID     String
  produtoID    String
  pedido       Pedido  @relation(fields: [pedidoID], references: [id])
  produto      Produto @relation(fields: [produtoID], references: [id])

  @@map("itens_pedidos")
}

model Configuracao {
  id                    String @id @default(uuid())
  tempoAdicionalMinutos Int    @default(0)

  @@map("configuracoes")
}

enum StatusPedido {
  PENDENTE
  PREPARANDO
  PRONTO
  EM_ROTA
  ENTREGUE
  CANCELADO
}

enum ModalEntrega {
  DELIVERY
  RETIRADA
}

enum MetodoPagamento {
  DINHEIRO
  MAQUININHA_CARTAO
}
